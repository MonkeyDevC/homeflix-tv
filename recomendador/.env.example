# Copiar a recomendador/.env (NUNCA al repo). En el VPS vive en ~/homeflix-recomendador/recomendador/.env

# Base de datos propia del motor (contenedor reco-db). Contraseñas largas y aleatorias:
#   openssl rand -hex 24
RECO_DB_ADMIN_PASSWORD=
RECO_DB_APP_PASSWORD=

# Secreto compartido con el servidor Node (servidor/.env → RECO_TOKEN). 32+ caracteres: openssl rand -hex 32
RECO_TOKEN=
# Servidor Node por la red interna (rutas /interno/v1/reco/*)
HOMEFLIX_INTERNO_URL=http://homeflix:3000

# Telegram: la cuenta Premium (lee el catálogo y transcribe) — my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# El bot de voz (@BotFather). Vacío = el worker corre sin bot.
BOT_TOKEN=
BOT_USERNAME=night_monkey_bot
# Id del grupo «NETSUCKS» (con -100…). Varios separados por coma.
CATALOGO_CHATS=
# Grupo privado «buzón» (bot + cuenta Premium) para transcribir audios de toda la familia. Vacío = solo del dueño.
BUZON_CHAT=
TRANSCRIBE_TIMEOUT=180

# TMDB (solo en el servidor): https://www.themoviedb.org/settings/api — una de las dos
TMDB_API_KEY=
TMDB_TOKEN=
TMDB_IDIOMA=es-MX

# Privacidad
RETENCION_BUSQUEDAS_DIAS=90
RETENCION_VOZ_DIAS=30
