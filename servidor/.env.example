# HomeFlix · servidor. Copia como .env en ~/homeflix-servidor del VPS (el despliegue lo crea solo la primera vez).
#
# Llave de la API interna (/interno/v1) para la consola de scalvache.shop: la misma que HOMEFLIX_ADMIN_TOKEN
# en la consola. 32 caracteres o más (openssl rand -hex 32). Vacía: la API interna no existe.
ADMIN_TOKEN=

