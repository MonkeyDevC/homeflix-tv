#!/usr/bin/env bash
# HomeFlix · acceso de colaborador al VPS: lo ÚNICO que puede hacer el usuario «deploycolab».
#
# Se instala en /usr/local/sbin/homeflix-colab (dueño root: el colaborador no puede cambiarlo) con servidor/scripts/colab/crear-colaborador.sh.
# La llave SSH del colaborador solo sirve para correr ESTE programa (authorized_keys con «command=» y «restrict»): no hay consola ni sftp ni
# reenvío de puertos. Con la orden original (SSH_ORIGINAL_COMMAND) este programa pasa a ser el usuario «deploy» con un sudo que solo permite
# este mismo archivo, y valida todo antes de tocar nada.
#
# Qué puede hacer (cada orden se manda con: ssh deploycolab@VPS <orden> [versión], y los archivos entran por stdin como .tar.gz):
#   estado                       la versión vigente, las versiones subidas, la web activa y si el contenedor «homeflix» está sano
#   ota-subir <v> [forzar]       sube la carpeta de una versión (web-<v>.json, homeflix-<v>.wgt/.apk, preparador-<v>.zip, instalar-preparador.cmd)
#                                a ~/homeflix-servidor/versiones/<v>/. No pisa la versión vigente si no se pide «forzar».
#   ota-actual                   pone actual.json (stdin): la versión que ven las apps. Solo si todos los archivos que nombra existen y su sha256 coincide.
#   ota-revertir                 vuelve al actual.json anterior (la versión de antes pasa a ser la vigente)
#   web-subir                    sube la web armada (dist/web) a una carpeta nueva de ~/homeflix-web/releases y la activa de golpe
#   web-revertir                 vuelve a la versión anterior de la web
# Lo que NO puede hacer: tocar el código ni el contenedor del servidor, Caddy, otros proyectos, el .env, ni ejecutar nada fuera de esta lista.
# Todo queda en el registro del sistema (journalctl -t homeflix-colab) con la hora y la IP de origen.
set -euo pipefail
umask 022

ENTRADA="${HC_ENTRADA:-deploycolab}"   # quién llega por SSH
DUENO="${HC_DUENO:-deploy}"            # como quién se trabaja
CASA="${HC_CASA:-/home/deploy}"
VERS="$CASA/homeflix-servidor/versiones"
WEB="$CASA/homeflix-web"
TMPR="$CASA/.homeflix-colab"
COPIAS="$TMPR/copias"
MAX_OTA=$((200 * 1024 * 1024))
MAX_WEB=$((150 * 1024 * 1024))
VER_RE='^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$'

die() { echo "Error: $*" >&2; exit 1; }

# ---- Paso 1: llega el colaborador (usuario deploycolab): se anota quién y qué, y se continúa como «deploy» ----
if [ "$(id -un)" = "$ENTRADA" ]; then
  orden="${SSH_ORIGINAL_COMMAND:-}"
  ip="${SSH_CONNECTION:-sin-ip}"; logger -t homeflix-colab "entra usuario=$ENTRADA desde=${ip%% *} orden=${orden:0:120}" 2>/dev/null || true
  read -r -a ARGS <<< "$orden"   # solo se separa por espacios: la orden nunca pasa por un intérprete de comandos
  exec sudo -n -u "$DUENO" "$0" "${ARGS[@]}"
fi

# ---- Paso 2: como «deploy», una sola orden a la vez ----
mkdir -p "$TMPR" "$COPIAS"
chmod 700 "$TMPR"
exec 9>"$TMPR/.cerrojo"
flock -w 120 9 || die "hay otra subida en curso; vuelve a intentar en un momento"

orden="${1:-ayuda}"
[ $# -gt 0 ] && shift || true

TRABAJO="$(mktemp -d "$TMPR/trabajo.XXXXXX")"
trap 'rm -rf "$TRABAJO"' EXIT

# Guarda stdin en un archivo con tope de tamaño.
recibir() { # <tope en bytes> <archivo>
  head -c $(($1 + 1)) > "$2"
  [ "$(stat -c %s "$2")" -le "$1" ] || die "el archivo pasa del tope de $(($1 / 1048576)) MB"
  [ -s "$2" ] || die "no llegó nada por la entrada"
}

# Revisa un .tar.gz ANTES de extraerlo: solo archivos y carpetas normales, rutas relativas sin «..», nombres sin caracteres raros ni ocultos.
revisar_tar() { # <archivo> <máximo de entradas>
  local f="$1" max="$2" n
  tar -tzf "$f" > "$TRABAJO/nombres" 2>/dev/null || die "el archivo no es un .tar.gz válido"
  tar -tzvf "$f" 2>/dev/null | cut -c1 > "$TRABAJO/tipos"
  n=$(wc -l < "$TRABAJO/nombres")
  [ "$n" -ge 1 ] && [ "$n" -le "$max" ] || die "cantidad de archivos fuera de lo permitido ($n)"
  [ "$(wc -l < "$TRABAJO/tipos")" -eq "$n" ] || die "listado inconsistente"
  grep -qvE '^[-d]$' "$TRABAJO/tipos" && die "solo se permiten archivos y carpetas (nada de enlaces ni dispositivos)"
  # cada ruta: partes separadas por «/», la primera letra de cada parte no es un punto; «./» al principio se permite
  grep -qvE '^(\./)?([A-Za-z0-9@+_-][A-Za-z0-9._@+ -]*/?)*$|^\./?$' "$TRABAJO/nombres" && die "hay nombres de archivo no permitidos"
  grep -qE '(^|/)\.\.(/|$)' "$TRABAJO/nombres" && die "rutas con «..» no permitidas"
  return 0
}

extraer() { # <archivo> <carpeta destino>
  mkdir -p "$2"
  tar -xzf "$1" -C "$2" --no-same-owner --no-same-permissions --no-overwrite-dir
  # por si acaso: después de extraer no puede haber nada que no sea archivo o carpeta
  [ -z "$(find "$2" ! -type f ! -type d -print -quit)" ] || { rm -rf "$2"; die "el contenido tenía algo que no es un archivo"; }
  find "$2" -type d -exec chmod 755 {} + ; find "$2" -type f -exec chmod 644 {} +
}

version_vigente() { [ -f "$VERS/actual.json" ] && jq -r '.version // empty' "$VERS/actual.json" 2>/dev/null || true; }

podar() { # <carpeta> <cuántas dejar> <patrón de ls>
  ls -1 "$1" 2>/dev/null | { grep -E "$3" || true; } | sort | head -n "-$2" | while read -r x; do rm -rf "${1:?}/$x"; done
}

case "$orden" in
  estado)
    echo "== Versión vigente (lo que ven las apps)"
    if [ -f "$VERS/actual.json" ]; then jq '{version, fecha, notas}' "$VERS/actual.json"; else echo "ninguna"; fi
    echo "== Versiones subidas (las últimas 8)"
    ls -1 "$VERS" 2>/dev/null | { grep -E "$VER_RE" || true; } | sort -V | tail -8
    echo "== Web (homeflix.fun)"
    if [ -L "$WEB/current" ]; then echo "activa: $(readlink "$WEB/current")"; ls -1 "$WEB/releases" 2>/dev/null | sort | tail -5; else echo "todavía no hay web activa"; fi
    echo "== Servidor"
    docker inspect -f 'contenedor homeflix: {{.State.Status}} ({{.State.Health.Status}})' homeflix 2>/dev/null || echo "contenedor homeflix: no se pudo consultar"
    ;;

  ota-subir)
    v="${1:-}"; extra="${2:-}"
    [[ "$v" =~ $VER_RE ]] || die "uso: ota-subir <versión como 1.2.3> [forzar]"
    [ "$v" != "$(version_vigente)" ] || [ "$extra" = "forzar" ] || die "$v es la versión vigente: sube una versión nueva, o repite con «forzar» (cambia los archivos que ya están sirviendo)"
    recibir "$MAX_OTA" "$TRABAJO/v.tgz"
    revisar_tar "$TRABAJO/v.tgz" 12
    extraer "$TRABAJO/v.tgz" "$TRABAJO/v"
    # carpeta sin subcarpetas y solo con los nombres que lleva una versión
    [ -z "$(find "$TRABAJO/v" -mindepth 1 -type d -print -quit)" ] || die "la versión no lleva carpetas"
    ve="${v//./\\.}"
    for f in "$TRABAJO"/v/*; do
      b="$(basename "$f")"
      [[ "$b" =~ ^(web-$ve\.json|homeflix-$ve\.(wgt|apk)|preparador-$ve\.zip|instalar-preparador\.cmd)$ ]] || die "archivo no permitido en una versión: $b"
    done
    [ -f "$TRABAJO/v/web-$v.json" ] || die "falta web-$v.json (la interfaz)"
    jq -e '.app == "homeflix-web" and .version == "'"$v"'"' "$TRABAJO/v/web-$v.json" >/dev/null 2>&1 || die "web-$v.json no es la interfaz de HomeFlix $v"
    rm -rf "$VERS/$v"
    mv "$TRABAJO/v" "$VERS/$v"
    echo "Subida la versión $v ($(ls -1 "$VERS/$v" | wc -l) archivos). Falta «ota-actual» para que las apps la vean."
    logger -t homeflix-colab "ota-subir $v" 2>/dev/null || true
    ;;

  ota-actual)
    recibir 65536 "$TRABAJO/actual.json"
    jq -e . "$TRABAJO/actual.json" >/dev/null 2>&1 || die "actual.json no es JSON válido"
    nueva="$(jq -r '.version // empty' "$TRABAJO/actual.json")"
    [[ "$nueva" =~ $VER_RE ]] || die "actual.json no trae una versión válida"
    [ -d "$VERS/$nueva" ] || die "la versión $nueva no está subida (usa antes ota-subir)"
    # todo lo que nombra tiene que existir en esa carpeta con el mismo tamaño y sha256
    for k in web wgt apk preparador instalador; do
      jq -e ".$k" "$TRABAJO/actual.json" >/dev/null 2>&1 || { [ "$k" = web ] && die "falta «web» en actual.json"; continue; }
      [ "$(jq -r ".$k | type" "$TRABAJO/actual.json")" = object ] || continue
      arch="$(jq -r ".$k.archivo // empty" "$TRABAJO/actual.json")"
      [[ "$arch" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,120}$ ]] || die "nombre de archivo no válido en «$k»"
      [ -f "$VERS/$nueva/$arch" ] || die "«$k» nombra $arch, que no está en la versión $nueva"
      [ "$(sha256sum "$VERS/$nueva/$arch" | cut -d' ' -f1)" = "$(jq -r ".$k.sha256" "$TRABAJO/actual.json")" ] || die "el sha256 de $arch no coincide con actual.json"
    done
    [ -f "$VERS/actual.json" ] && cp -p "$VERS/actual.json" "$COPIAS/actual-$(date +%Y%m%d-%H%M%S).json"
    podar "$COPIAS" 15 '^actual-.*\.json$'
    cp "$TRABAJO/actual.json" "$VERS/actual.json.nuevo"
    chmod 644 "$VERS/actual.json.nuevo"
    mv -f "$VERS/actual.json.nuevo" "$VERS/actual.json"
    echo "Vigente: $nueva. Las apps la verán en su próxima revisión."
    logger -t homeflix-colab "ota-actual $nueva" 2>/dev/null || true
    ;;

  ota-revertir)
    ult="$(ls -1 "$COPIAS" 2>/dev/null | { grep -E '^actual-.*\.json$' || true; } | sort | tail -n 1)"
    [ -n "$ult" ] || die "no hay un actual.json anterior guardado"
    [ -f "$VERS/actual.json" ] && cp -p "$VERS/actual.json" "$COPIAS/actual-$(date +%Y%m%d-%H%M%S)-revertido.json"
    cp "$COPIAS/$ult" "$VERS/actual.json.nuevo"; chmod 644 "$VERS/actual.json.nuevo"; mv -f "$VERS/actual.json.nuevo" "$VERS/actual.json"
    rm -f "$COPIAS/$ult"
    echo "Vuelve a ser vigente: $(version_vigente)"
    logger -t homeflix-colab "ota-revertir -> $(version_vigente)" 2>/dev/null || true
    ;;

  web-subir)
    recibir "$MAX_WEB" "$TRABAJO/w.tgz"
    revisar_tar "$TRABAJO/w.tgz" 4000
    extraer "$TRABAJO/w.tgz" "$TRABAJO/w"
    [ -f "$TRABAJO/w/index.html" ] || die "falta index.html: ¿es la carpeta dist/web?"
    sello="$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$WEB/releases"
    mv "$TRABAJO/w" "$WEB/releases/$sello"
    ln -sfn "releases/$sello" "$WEB/current.tmp" && mv -T "$WEB/current.tmp" "$WEB/current"
    podar "$WEB/releases" 5 '^[0-9]{8}-[0-9]{6}$'
    echo "Web activa: releases/$sello"
    logger -t homeflix-colab "web-subir $sello" 2>/dev/null || true
    ;;

  web-revertir)
    [ -L "$WEB/current" ] || die "todavía no hay web activa"
    cur="$(basename "$(readlink "$WEB/current")")"
    prev="$(ls -1 "$WEB/releases" | grep -E '^[0-9]{8}-[0-9]{6}$' | sort | grep -B1 -x "$cur" | head -n 1 || true)"
    { [ -n "$prev" ] && [ "$prev" != "$cur" ]; } || die "no hay una versión anterior de la web"
    ln -sfn "releases/$prev" "$WEB/current.tmp" && mv -T "$WEB/current.tmp" "$WEB/current"
    echo "Web activa: releases/$prev"
    logger -t homeflix-colab "web-revertir -> $prev" 2>/dev/null || true
    ;;

  ayuda|help|-h|--help|"")
    sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    echo "Orden no permitida: $orden" >&2
    echo "Las permitidas: estado, ota-subir <v> [forzar], ota-actual, ota-revertir, web-subir, web-revertir" >&2
    exit 2
    ;;
esac
